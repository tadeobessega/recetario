{
  "name": "recetario",
  "main": "worker.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "vars": {
    // Monetización de los enlaces de salida (/go). Ver README.md → "Monetizar los enlaces".
    // Página puente propia: un banner y redirección automática a los 3 segundos.
    // Completá UNA de estas opciones:
    //   A-ADS (solo banners, sin pop-ups, sin aprobación): el número de tu bloque de anuncios.
    "AADS_ID": "",
    //   Otra red (ej. Native Banner de Adsterra): pegá su código HTML entre comillas.
    "ANUNCIO_SALIDA_HTML": "",
    //   Google AdSense (requiere aprobación). Con ADSENSE_CLIENTE también se sirve /ads.txt.
    "ADSENSE_CLIENTE": "",
    "ADSENSE_BLOQUE_SALIDA": "",
    // Acortador con {url} (desaconsejado: abren muchas ventanas). Si se carga, tiene prioridad.
    "MONETIZAR_URL": ""
    // Todo vacío = salida directa, sin monetizar.
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    }
  ]
}
