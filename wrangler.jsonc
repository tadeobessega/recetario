{
  "name": "recetario",
  "main": "worker.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "vars": {
    // Monetización de los enlaces de salida (/go). Ver README.md → "Monetizar los enlaces".
    // Opción 1: acortador que paga por clic, con {url} donde va el destino.
    //   Ej: "https://servicio.com/api?api=TU_TOKEN&url={url}"
    "MONETIZAR_URL": "https://shrinkme.io/st?api=80f4f44a0d0e68bdc25e8721dd9803860b571f8a&url={url}",
    // Opción 2: página propia con un anuncio de AdSense antes de salir.
    //   Ej: "ca-pub-1234567890123456" y el ID de un bloque de anuncios.
    //   Con ADSENSE_CLIENTE cargado también se sirve /ads.txt.
    "ADSENSE_CLIENTE": "",
    "ADSENSE_BLOQUE_SALIDA": ""
    // Las dos vacías = salida directa, sin monetizar.
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    }
  ]
}
